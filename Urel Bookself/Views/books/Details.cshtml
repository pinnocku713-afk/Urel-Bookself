@model Book
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p>@Model.Author · @Model.Pages pages</p>
<p>
    @if (Model.IsRead)
    {
        <strong>Read</strong>
    }
    else
    {
        <strong>Not read yet</strong>
    }
</p>

<p>
    @if (Model.Id > 1)
    {
        <a asp-action="Details" asp-route-id="@(Model.Id - 1)">Prev</a>
    }
    @if (Model.Id < 6)
    {
        <a asp-action="Details" asp-route-id="@(Model.Id + 1)">Next</a>
    }
</p>