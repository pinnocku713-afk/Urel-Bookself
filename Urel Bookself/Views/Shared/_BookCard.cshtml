@model Book

<div class="card mb-2">
    <div class="card-body">
        <h5 class="card-title">
            <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
            @if (Model.IsRead)
            {
                <span class="badge bg-success">Read</span>
            }
        </h5>
        <p class="card-text mb-0">@Model.Author · @Model.Pages pages</p>
        @if (!Model.IsRead)
        {
            <a class="btn btn-sm btn-outline-primary mt-2"
               asp-controller="Books" asp-action="MarkRead" asp-route-id="@Model.Id">Mark as read</a>
        }
    </div>
</div>
